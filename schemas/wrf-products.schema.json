{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIDERAL WRF products",
  "type": "object",
  "required": ["model", "cycle", "forecast_hours", "files"],
  "properties": {
    "model": {"type": "string", "minLength": 1},
    "cycle": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$"},
    "forecast_hours": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "sha256", "bytes"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  },
  "additionalProperties": true
}
